# Server-side environment for docker-compose.prod.yml.
# Copy this to ".env" in the deploy directory on the vServer and fill in values.
# This file lives ONLY on the server — never commit the real ".env".

# --- Image (the deploy pipeline keeps this up to date; pin a version to roll back) ---
APP_IMAGE=ghcr.io/melf11/kleinanzeigen-watcher:latest

# --- HTTPS (Caddy) ---
DOMAIN=watcher.example.com
ACME_EMAIL=you@example.com

# --- App ---
# Generate with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=CHANGE_ME_min_32_random_chars
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_PASSWORD=CHANGE_ME_strong_password
# Optional: seeds the admin's kleinanzeigen-agent token on first start.
NUXT_KLAZ_API_KEY=
NUXT_TZ=Europe/Berlin
# With HTTPS (Caddy) keep this true. Only set false for a plain-HTTP/IP setup.
NUXT_SESSION_COOKIE_SECURE=true

# --- Postgres ---
POSTGRES_USER=watcher
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=watcher
