# --- Database ---
# Inside docker-compose the host is the service name "db".
NUXT_DATABASE_URL=postgres://watcher:watcher@db:5432/watcher

# --- Auth / session ---
# Seeded admin account (dev default admin/admin). Change for production!
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_PASSWORD=admin
# Must be at least 32 characters — used to seal the session cookie.
NUXT_SESSION_PASSWORD=please-change-me-to-a-long-random-string-min-32-chars

# --- kleinanzeigen-agent API ---
# Optional: only used to pre-fill the dev admin's personal token on first seed.
# In normal use every user stores their own token under /settings.
NUXT_KLAZ_API_KEY=

# --- Scheduling ---
# Timezone for the per-search "run at HH:MM" anchor.
NUXT_TZ=Europe/Berlin

# --- E-Mail (SMTP) for verification / password reset ---
# Leave NUXT_SMTP_HOST empty in dev → emails are printed to the console instead.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=
NUXT_SMTP_SECURE=false
# Public base URL used in email links (e.g. https://watcher.example.com)
NUXT_PUBLIC_APP_URL=

# --- Postgres container (used by docker-compose) ---
POSTGRES_USER=watcher
POSTGRES_PASSWORD=watcher
POSTGRES_DB=watcher
